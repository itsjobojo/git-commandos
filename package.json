{
  "name": "git-commandos",
  "version": "1.0.0",
  "description": "Git, but you have to earn it. A 3D extraction shooter CLI that wraps git and gates real commits behind gameplay.",
  "bin": {
    "gcmds": "./cli/index.mjs",
    "git-commandos": "./cli/index.mjs"
  },
  "files": [
    "cli/",
    "!cli/**/*.test.mjs",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "gcmds": "node cli/index.mjs",
    "dev": "vite",
    "tsc": "tsc --noEmit && vite build",
    "build": "node scripts/copy-audio-worklets.mjs && vite build",
    "prepare": "node scripts/copy-audio-worklets.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "cli",
    "game",
    "commit",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@types/three": "^0.185.3",
    "chiptune3": "^0.8.7",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "open": "^10.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
