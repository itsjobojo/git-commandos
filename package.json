{
  "name": "git-commandos",
  "version": "1.0.0",
  "description": "Git, but you have to earn it. A 2D action game CLI that gates real git operations.",
  "main": "index.js",
  "bin": {
    "gcmds": "./cli/index.mjs"
  },
  "files": [
    "cli/",
    "dist/"
  ],
  "scripts": {
    "gcmds": "node cli/index.mjs",
    "dev": "vite",
    "tsc": "tsc --noEmit && vite build",
    "build": "vite build",
    "prepublishOnly": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/audio',{recursive:true});['chiptune3.worklet.js','libopenmpt.worklet.js'].forEach(f=>fs.copyFileSync('node_modules/chiptune3/'+f,'public/audio/'+f))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "chiptune3": "^0.8.7",
    "open": "^10.1.0",
    "ws": "^8.18.0"
  }
}
